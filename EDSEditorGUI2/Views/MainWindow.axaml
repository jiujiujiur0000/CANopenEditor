<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:vm="using:EDSEditorGUI2.ViewModels"
        xmlns:view="using:EDSEditorGUI2.Views"
        xmlns:converter="using:EDSEditorGUI2.Converter"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EDSEditorGUI2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Title="EDSEditorGUI2">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <dialogHost:DialogHost Identifier="RootDialogHost" >
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0" x:Name="menu">
                <MenuItem Header="{DynamicResource str_menu_file}" x:Name="fileMenu" >
                    <MenuItem Header="{DynamicResource str_menu_new}" Command="{Binding AddNewDevice}"/>
                    <MenuItem Header="{DynamicResource str_menu_open}" Click="OpenFileClick"/>
                    <MenuItem Header="{DynamicResource str_menu_save}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <MenuItem Header="{DynamicResource str_menu_save_as}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_open_network}"/>
                    <MenuItem Header="{DynamicResource str_menu_save_network}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_recent}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_export}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <MenuItem Header="{DynamicResource str_menu_export_canopennode}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <MenuItem Header="{DynamicResource str_menu_save_all}" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_quit}"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource str_menu_insert_profile}" x:Name="profileMenu" IsEnabled="{Binding SelectedDevice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <MenuItem Header="{DynamicResource str_menu_reports}">
                </MenuItem>
                <MenuItem Header="{DynamicResource str_menu_tools}">
                    <MenuItem Header="{DynamicResource str_menu_preferences}" Click="OpenPreferences"/>
                </MenuItem>
            </Menu>
            <Button x:Name="ThemeButton" Grid.Column="1" Content="🖥️ 跟随系统" Click="ToggleTheme_Click" Margin="5,0,10,0" Padding="8,4" Background="Transparent" BorderThickness="1" CornerRadius="4" Cursor="Hand" VerticalAlignment="Center"/>
        </Grid>
        <Grid>
            <!-- 欢迎界面（没有设备时显示） -->
            <Grid IsVisible="{Binding HasNoDevice}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Text="欢迎使用 CANopen Editor" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="请选择一个操作开始" FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,30,0,0">
                        <Button Content="📄 新建项目" Command="{Binding AddNewDevice}" Classes="accent" FontSize="16" Padding="25,12" CornerRadius="8" Cursor="Hand"/>
                        <Button Content="📂 打开文件" Click="OpenFileClick" FontSize="16" Padding="25,12" CornerRadius="8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 主编辑器区域（有设备时显示） -->
            <DockPanel IsVisible="{Binding HasDevice}">
                <StackPanel DockPanel.Dock="Left" Margin="20" Width="300">
                    <ListBox ItemsSource="{Binding Network}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding DeviceInfo.ProductName}" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <view:DeviceView DataContext="{Binding SelectedDevice}" />
            </DockPanel>
        </Grid>
    </DockPanel>
  </dialogHost:DialogHost>

  <Window.Resources>
    <!-- Preferences dialog -->
    <view:PreferencesView x:Key="PreferencesDialog"/>
    
    <!-- Insert Objects dialog -->
    <StackPanel x:Key="InsertObjectsDialog" MaxWidth="900">
      <TextBlock Text="{DynamicResource str_insert_target}" />
      <ComboBox x:Name="InsertObjects_target" ItemsSource="{Binding Network}" SelectedItem="{Binding SelectedDevice}" MaxDropDownHeight="100"  />
      <TextBlock Text="{DynamicResource str_insert_offset}" />
	  <TextBox x:Name="InsertObjects_Offsets" Watermark="1 100 500" Text="0" TextChanged="OnOffsetTextChanged"/>

      <ScrollViewer>
        <DataGrid Margin="20" ItemsSource="{Binding MergeStatus}"
            GridLinesVisibility="All"
            BorderThickness="1" BorderBrush="Gray"
                  MaxHeight="500"
                  x:Name="grid">

          <DataGrid.Columns>
            <DataGridCheckBoxColumn  Header="{DynamicResource str_insert_col_insert}" Width="*"
                    Binding="{Binding Insert}"/>
            <DataGridTextColumn Header="{DynamicResource str_insert_col_original}" Width="*" IsReadOnly="True"
                    Binding="{Binding OriginalObject}" />
		      </DataGrid.Columns>
        </DataGrid>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal">
		    <Button x:Name="InsertObjects_Insert" IsDefault="True" Margin="10" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="insert" Content="{DynamicResource str_insert_btn_insert}"/>
        <Button x:Name="InsertObjects_Cancel" IsCancel="True" Margin="10" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" Content="{DynamicResource str_btn_cancel}"/>
      </StackPanel>
    </StackPanel>
  </Window.Resources>
</Window>
