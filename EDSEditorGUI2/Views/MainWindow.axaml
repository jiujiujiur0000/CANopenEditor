<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        xmlns:vm="using:EDSEditorGUI2.ViewModels"
        xmlns:view="using:EDSEditorGUI2.Views"
        xmlns:converter="using:EDSEditorGUI2.Converter"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EDSEditorGUI2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        PointerPressed="Window_PointerPressed"
        Title="CANopen Editor 2">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    <dialogHost:DialogHost Identifier="RootDialogHost" >
    <DockPanel Background="Transparent">
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0" x:Name="menu">
                <MenuItem Header="{DynamicResource str_menu_file}" x:Name="fileMenu" >
                    <MenuItem Header="{DynamicResource str_menu_new_project}" Click="NewProjectClick"/>
                    <MenuItem Header="{DynamicResource str_menu_open_project}" Click="OpenProjectClick"/>
                    <MenuItem Header="{DynamicResource str_menu_save_project}" Click="SaveProjectClick" IsEnabled="{Binding IsDirty}"/>
                    <MenuItem Header="{DynamicResource str_menu_save_project_as}" Click="SaveProjectAsClick" IsEnabled="{Binding HasDevice}"/>
                    <MenuItem Header="{DynamicResource str_menu_close_project}" Click="CloseProjectClick" IsEnabled="{Binding HasDevice}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_new_device}" Command="{Binding AddNewDevice}" IsEnabled="{Binding IsProjectMode}"/>
                    <MenuItem Header="{DynamicResource str_menu_import_device}" Click="OpenFileClick" IsEnabled="{Binding IsProjectMode}"/>
                    <MenuItem Header="{DynamicResource str_menu_remove_device}" Command="{Binding CloseDeviceCommand}" CommandParameter="{Binding SelectedDevice}" IsEnabled="{Binding CanRemoveDevice}"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_recent}">
                        <MenuItem Header="{DynamicResource str_menu_recent_empty}" IsVisible="{Binding !HasRecentFiles}" IsEnabled="False"/>
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <MenuItem Click="OpenRecentFileClick">
                                        <MenuItem.Header>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                                <Button Grid.Column="1" Content="❌" Background="Transparent" BorderThickness="0" Padding="5,0"
                                                        Command="{Binding $parent[Window].DataContext.RemoveRecentFileCommand}" 
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator IsVisible="{Binding HasRecentFiles}"/>
                        <MenuItem Header="{DynamicResource str_menu_clear_recent}" Click="ClearRecentFilesClick" IsVisible="{Binding HasRecentFiles}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_export_device}" IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <MenuItem Header="{DynamicResource str_menu_export_eds}" Click="ExportCurrentDeviceEdsClick"/>
                        <MenuItem Header="{DynamicResource str_menu_export_source}">
                            <MenuItem Header="{DynamicResource str_menu_export_source_v4}" Click="ExportCurrentDeviceSourceV4Click"/>
                            <MenuItem Header="{DynamicResource str_menu_export_source_legacy}" Click="ExportCurrentDeviceSourceLegacyClick"/>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{DynamicResource str_menu_export_all}" IsEnabled="{Binding HasDevice}">
                        <MenuItem Header="{DynamicResource str_menu_export_eds}"/>
                        <MenuItem Header="{DynamicResource str_menu_export_source}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{DynamicResource str_menu_quit}" Click="QuitClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource str_menu_insert_profile}" x:Name="profileMenu" IsEnabled="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <MenuItem Header="{DynamicResource str_menu_reports}">
                </MenuItem>
                <MenuItem Header="{DynamicResource str_menu_preferences}" Click="OpenPreferences"/>
            </Menu>
            </Grid>
        </Border>
        <Grid>
            <!-- 欢迎界面（没有设备时显示） -->
            <Grid IsVisible="{Binding HasNoDevice}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Text="{DynamicResource str_welcome_title}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,30,0,0">
                        <Button Content="{DynamicResource str_btn_new_project}" Click="NewProjectClick" Classes="accent" FontSize="16" Padding="25,12" CornerRadius="8" Cursor="Hand"/>
                        <Button Content="{DynamicResource str_btn_open_project}" Click="OpenProjectClick" FontSize="16" Padding="25,12" CornerRadius="8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 主编辑器区域（有设备时显示），统一底色防止缝隙漏出灰底 -->
            <Grid IsVisible="{Binding HasDevice}" Background="#F3F4F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- 恢复右边框作为视觉上的 1 像素细线，并单独设置极浅灰底色 -->
                <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="设备网络" FontWeight="Bold" Margin="15,15,10,10" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        
                        <ListBox Grid.Row="1" ItemsSource="{Binding Network}" SelectedItem="{Binding SelectedDevice}" 
                                 Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- 关键：把 Padding 设为 0，让内部的 Grid 彻底占满蓝色的可选区域 -->
                                    <Setter Property="Padding" Value="0" />
                                    <!-- 在可选区域（整行）加上下边框，为防止双线，列表项只画下边框，上边框交由 ListBox 画 -->
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 根节点使用 Border，Background 设为 Transparent 以接收整个区域的鼠标右键事件，并使用 Padding 替代 Grid 不能使用的 Padding 属性 -->
                                    <Border Background="Transparent" Padding="15,12">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="新建设备" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddNewDevice}"/>
                                                <MenuItem Header="导入设备" Click="OpenFileClick"/>
                                                <Separator/>
                                                <MenuItem Header="移除设备" 
                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseDeviceCommand}" 
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="导出当前设备">
                                                    <MenuItem Header="EDS / XDD 格式" Click="ExportCurrentDeviceEdsClick"/>
                                                    <MenuItem Header="CANopenNode 源码">
                                                        <MenuItem Header="导出为 V4 最新版" Click="ExportCurrentDeviceSourceV4Click"/>
                                                        <MenuItem Header="导出为 V1-V3 兼容版" Click="ExportCurrentDeviceSourceLegacyClick"/>
                                                    </MenuItem>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- 设备名，靠左对齐 -->
                                            <TextBlock Grid.Column="0" Text="{Binding DeviceInfo.ProductName}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
                                            
                                            <!-- 未保存提示绿点，靠右对齐 -->
                                            <Ellipse Grid.Column="1" Width="6" Height="6" Fill="#00CC00" VerticalAlignment="Center" Margin="6,0,0,0" HorizontalAlignment="Right"
                                                     IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsDirty}" 
                                                     ToolTip.Tip="有未保存的修改"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <!-- GridSplitter 设置为透明并放置在第一列最右侧悬浮，不占据额外宽度，从而让右侧紧挨着分割线 -->
                <GridSplitter Grid.Column="0" HorizontalAlignment="Right" Width="5" Background="Transparent" ResizeDirection="Columns" />
                
                <ContentControl Grid.Column="1" Content="{Binding SelectedDevice}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <view:DeviceView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>
    </DockPanel>
  </dialogHost:DialogHost>

  <Window.Resources>
    <!-- Preferences dialog -->
    <view:PreferencesView x:Key="PreferencesDialog"/>
    
    <StackPanel x:Key="SaveConfirmDialog" Margin="20" Spacing="15" MinWidth="300">
        <TextBlock Text="未保存的修改" FontWeight="Bold" FontSize="18"/>
        <TextBlock Text="您有未保存的修改，是否在退出前将它们保存为项目？" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="保存 (Save)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="Save" Classes="accent"/>
            <Button Content="丢弃 (Discard)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="Discard"/>
            <Button Content="取消 (Cancel)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="Cancel"/>
        </StackPanel>
    </StackPanel>

    <StackPanel x:Key="ErrorDialog" Margin="20" Spacing="15" MinWidth="300">
        <TextBlock Text="无法打开文件" FontWeight="Bold" FontSize="18" Foreground="Red"/>
        <TextBlock Text="文件格式可能已损坏，或保存时不完整（缺少设备信息）。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="确定 (OK)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="OK" Classes="accent"/>
        </StackPanel>
    </StackPanel>

    <StackPanel x:Key="SaveErrorDialog" Margin="20" Spacing="15" MinWidth="300">
        <TextBlock Text="保存失败" FontWeight="Bold" FontSize="18" Foreground="Red"/>
        <TextBlock Text="保存项目时遇到错误。可能是工程中存在不兼容的特殊字符或内部数据损坏。请检查终端输出获取详情。" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="确定 (OK)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="OK" Classes="accent"/>
        </StackPanel>
    </StackPanel>

    <StackPanel x:Key="ClearRecentConfirmDialog" Margin="20" Spacing="15" MinWidth="300">
        <TextBlock Text="{DynamicResource str_menu_clear_recent}" FontWeight="Bold" FontSize="18"/>
        <TextBlock Text="{DynamicResource str_msg_confirm_clear}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="确定 (OK)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="OK" Classes="accent"/>
            <Button Content="取消 (Cancel)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="Cancel"/>
        </StackPanel>
    </StackPanel>

    <StackPanel x:Key="FileNotFoundDialog" Margin="20" Spacing="15" MinWidth="300" MaxWidth="500">
        <TextBlock Text="文件不存在" FontWeight="Bold" FontSize="18" Foreground="Red"/>
        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="确定 (OK)" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="OK" Classes="accent"/>
        </StackPanel>
    </StackPanel>

    <!-- Insert Objects dialog -->
    <StackPanel x:Key="InsertObjectsDialog" MaxWidth="900">
      <TextBlock Text="{DynamicResource str_insert_target}" />
      <ComboBox x:Name="InsertObjects_target" ItemsSource="{Binding Network}" SelectedItem="{Binding SelectedDevice}" MaxDropDownHeight="100"  />
      <TextBlock Text="{DynamicResource str_insert_offset}" />
	  <TextBox x:Name="InsertObjects_Offsets" Watermark="1 100 500" Text="0" TextChanged="OnOffsetTextChanged"/>

      <ScrollViewer>
        <Border Margin="20" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="8" ClipToBounds="True">
          <DataGrid ItemsSource="{Binding MergeStatus}"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent" RowBackground="Transparent"
                    MaxHeight="500"
                    x:Name="grid">
            <DataGrid.Styles>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="SeparatorBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
              </Style>
              <Style Selector="DataGridColumnHeader:nth-last-child(1)">
                <Setter Property="SeparatorBrush" Value="Transparent"/>
              </Style>
            </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn  Header="{DynamicResource str_insert_col_insert}" Width="*"
                    Binding="{Binding Insert}"/>
            <DataGridTextColumn Header="{DynamicResource str_insert_col_original}" Width="*" IsReadOnly="True"
                    Binding="{Binding OriginalObject}" />
		      </DataGrid.Columns>
          </DataGrid>
        </Border>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal">
		    <Button x:Name="InsertObjects_Insert" IsDefault="True" Margin="10" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" CommandParameter="insert" Content="{DynamicResource str_insert_btn_insert}"/>
        <Button x:Name="InsertObjects_Cancel" IsCancel="True" Margin="10" Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=dialogHost:DialogHost}, Path=CloseDialogCommand}" Content="{DynamicResource str_btn_cancel}"/>
      </StackPanel>
    </StackPanel>
  </Window.Resources>
</Window>
