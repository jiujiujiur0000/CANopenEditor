<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDSEditorGUI2.ViewModels"
             xmlns:view="using:EDSEditorGUI2.Views"
             xmlns:converter="using:EDSEditorGUI2.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:EDSEditorGUI2"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="EDSEditorGUI2.Views.DevicePDOView"
             x:DataType="vm:DevicePDOViewModel">

  <ScrollViewer BringIntoViewOnFocusChange="False">
    <StackPanel Spacing="15" Margin="15,5,15,15" MaxWidth="1200">
      
      <!-- Top Area: DataGrid & Properties -->
      <Grid ColumnDefinitions="*, 450" MinHeight="350">
        <!-- Left: DataGrid -->
        <Border Grid.Column="0" Margin="0,0,15,0" Height="{Binding #RightPropertiesCard.Bounds.Height}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="8" ClipToBounds="True">
          <DataGrid ItemsSource="{Binding AvailableObjects}"
                    x:Name="subindexGrid"
                    CanUserResizeColumns="True"
                    local:DataGridBehavior.LockAutoMinWidth="True"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent" RowBackground="Transparent"
                    FocusAdorner="{x:Null}">
            <DataGrid.Styles>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="SeparatorBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
              </Style>
              <Style Selector="DataGridColumnHeader:nth-last-child(1)">
                <Setter Property="SeparatorBrush" Value="Transparent"/>
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource str_pdo_col_index}" Width="Auto" Binding="{Binding IndexString}"/>
              <DataGridTextColumn Header="{DynamicResource str_pdo_col_sub}" Width="Auto" Binding="{Binding SubIndexString}"/>
              <DataGridTextColumn Header="{DynamicResource str_pdo_col_name}" Width="2*" Binding="{Binding Name}"/>
              <DataGridTextColumn Header="{DynamicResource str_pdo_col_datatype}" Width="Auto" Binding="{Binding ObjectTypeString}"/>
              <DataGridTextColumn Header="{DynamicResource str_pdo_col_bits}" Width="Auto" Binding="{Binding TypeSize}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <!-- Right: Properties Card -->
        <Border x:Name="RightPropertiesCard" Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="25"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                BoxShadow="0 2 6 0 #1A000000" VerticalAlignment="Top">
          <StackPanel Spacing="15">
            <TextBlock Text="{DynamicResource str_pdo_comm_params}" FontWeight="Bold" FontSize="15" Margin="0,0,0,5"/>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,0,0,1" Margin="0,-15,0,5" Opacity="0.3"/>

            <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto" ColumnDefinitions="auto,auto,auto,auto" Margin="0,0,25,0">
            <!-- Header for Properties -->
            <ComboBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,15" Width="200" HorizontalAlignment="Left"
                      ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" SelectedIndex="0">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- TextBoxes for Selected PDO -->
            <TextBlock Text="{DynamicResource str_pdo_comm}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.Communication, Mode=OneWay, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}" IsReadOnly="True"/>

            <TextBlock Text="{DynamicResource str_pdo_mapping}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.Mapping, Mode=OneWay, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}" IsReadOnly="True"/>
            <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Classes="accent" VerticalAlignment="Top" Padding="15,10" Height="70" Width="100">
              <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource add_regular}" />
                <TextBlock Text="{DynamicResource str_pdo_btn_add}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Text="{DynamicResource str_pdo_cob}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.COB, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}"/>
            
            <!-- Invalid Checkbox moved next to COB -->
            <CheckBox Grid.Row="3" Grid.Column="2" Content="{DynamicResource str_pdo_chk_invalid}" IsChecked="{Binding SelectedSlot.Invalid}" IsEnabled="{Binding IsSlotSelected}" Margin="0,0,15,15" VerticalAlignment="Center"/>

            <TextBlock Text="{DynamicResource str_pdo_type}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.TransmissionType, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}"/>
            <Button Grid.Row="4" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Top" Padding="15,10" Height="70" Width="100">
              <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource remove_regular}" />
                <TextBlock Text="{DynamicResource str_pdo_btn_delete}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Button>

            <TextBlock Text="{DynamicResource str_pdo_inhibit}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.Inhibit, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}"/>

            <TextBlock Text="{DynamicResource str_pdo_event_timer}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.EventTimer, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}"/>

            <TextBlock Text="{DynamicResource str_pdo_sync_start}" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,15"/>
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,15,15" Text="{Binding SelectedSlot.SyncStart, FallbackValue=''}" IsEnabled="{Binding IsSlotSelected}"/>
          </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Bottom Area: Mapping Visualizer -->
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="25"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
              BoxShadow="0 2 6 0 #1A000000">
        <StackPanel Spacing="15">
          <StackPanel Orientation="Horizontal" Spacing="20">
            <TextBlock Text="{DynamicResource str_pdo_zoom}" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="Zoom" Width="150" PropertyChanged="Zoom_PropertyChanged" Minimum="100" Increment="10"/>
          </StackPanel>
          <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AllowAutoHide="False" Height="250" Margin="0,10,0,0">
            <Border BorderBrush="LightGray" BorderThickness="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Grid x:Name="MappingGrid" ColumnDefinitions="Auto,Auto,Auto">
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="LightGray" BorderThickness="0,0,1,1" Padding="5">
                  <TextBlock Text="{DynamicResource str_pdo_id}" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="LightGray" BorderThickness="0,0,1,1" Padding="5">
                  <TextBlock Text="{DynamicResource str_pdo_cob}" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" BorderBrush="LightGray" BorderThickness="0,0,1,1" Padding="5">
                  <TextBlock Text="{DynamicResource str_pdo_col_index}" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
