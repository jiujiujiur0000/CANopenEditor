<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EDSEditorGUI2.ViewModels"
             xmlns:view="using:EDSEditorGUI2.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="EDSEditorGUI2.Views.DeviceInfoView"
             x:DataType="vm:Device">
  <UserControl.Styles>
    <Style Selector="FlyoutPresenter.desc-flyout">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <Grid ColumnDefinitions="*, *" Margin="15,5,15,15" HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxWidth="1200">
      
      <!-- Left Column -->
      <Grid Grid.Column="0" RowDefinitions="Auto, Auto" Margin="0,0,7.5,0" VerticalAlignment="Top">
        <!-- Card 1: Device Info -->
        <Border Grid.Row="0" Margin="0,0,0,15" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="25"
                BoxShadow="0 4 10 0 #1A000000">
          <StackPanel Spacing="15" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource str_dyn_018}" FontWeight="Bold" FontSize="15"/>
            <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_dyn_037}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceInfo.ProductName}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_dyn_006}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceInfo.ProductNumber}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource str_dyn_014}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeviceInfo.VendorName}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource str_dyn_038}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeviceInfo.VendorNumber}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource str_dyn_042}" VerticalAlignment="Center"/>
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DeviceInfo.RevisionNumber}" HorizontalAlignment="Stretch" Classes="clearButton"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Card 2: File Info -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="25"
                BoxShadow="0 4 10 0 #1A000000">
          <StackPanel Spacing="15" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource str_dyn_048}" FontWeight="Bold" FontSize="15"/>
            
            <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_dyn_053}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FileInfo.FileVersion}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_dyn_015}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FileInfo.CreatedBy}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource str_dyn_003}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FileInfo.CreationTime, StringFormat=\{0:yyyy/MM/dd HH:mm:ss\}}" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource str_dyn_016}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FileInfo.ModifiedBy}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource str_dyn_024}" VerticalAlignment="Center" Margin="0,0,0,15"/>
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FileInfo.ModificationTime, StringFormat=\{0:yyyy/MM/dd HH:mm:ss\}}" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,15"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource str_dyn_049}" VerticalAlignment="Center" Margin="0,0,0,0"/>
              <Button x:Name="fileDescButton" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" MinHeight="32" 
                      Background="{DynamicResource TextControlBackground}"
                      BorderBrush="{DynamicResource TextControlBorderBrush}"
                      BorderThickness="{DynamicResource TextControlBorderThemeThickness}">
                <TextBlock Text="{Binding FileInfo.Description}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <Button.Flyout>
                  <Flyout Placement="Top" FlyoutPresenterClasses="desc-flyout">
                    <TextBox Text="{Binding FileInfo.Description}" Width="{Binding #fileDescButton.Bounds.Width}" Height="200" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Watermark="{DynamicResource str_dyn_010}"/>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

      </Grid>

      <!-- Right Column -->
      <StackPanel Grid.Column="1" Spacing="15" Margin="7.5,0,0,0">
        <!-- Card 3: Baudrates Section -->
        <Border Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="25"
                BoxShadow="0 4 10 0 #1A000000">
          <StackPanel Spacing="15" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource str_device_info_baudrates}" FontWeight="Bold" FontSize="15"/>
            <UniformGrid Columns="3" Margin="10,0,0,0">
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate10}" Content="10 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate20}" Content="20 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate50}" Content="50 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate125}" Content="125 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate250}" Content="250 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate500}" Content="500 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate800}" Content="800 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRate1000}" Content="1000 kbit/s" Margin="0,0,0,15"/>
              <CheckBox IsChecked="{Binding DeviceInfo.BaudRateAuto}" Content="{DynamicResource str_dyn_007}" Margin="0,0,0,15"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Card 4: Features Section -->
        <Border Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="25"
                BoxShadow="0 4 10 0 #1A000000">
          <StackPanel Spacing="15" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource str_dyn_031}" FontWeight="Bold" FontSize="15"/>
            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_dyn_017}" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceInfo.Granularity}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_device_info_rpdo_count}" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceInfo.RpdoCount}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource str_device_info_tpdo_count}" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeviceInfo.TpdoCount}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource str_device_info_monitored_nodes}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeviceInfo.NumberOfMonitoredNodes}" HorizontalAlignment="Stretch" Classes="clearButton"/>
            </Grid>

            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" RowDefinitions="Auto, Auto" Margin="0,15,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_device_info_lss_slave}" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding DeviceInfo.LssSlave}" Margin="0,0,15,15"/>

              <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource str_device_info_lss_master}" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <CheckBox Grid.Row="0" Grid.Column="4" IsChecked="{Binding DeviceInfo.LssMaster}" Margin="0,0,0,15"/>
              
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_device_info_node_guarding_slave}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DeviceInfo.NodeGuardingSlave}" Margin="0,0,15,0"/>

              <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource str_device_info_node_guarding_master}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <CheckBox Grid.Row="1" Grid.Column="4" IsChecked="{Binding DeviceInfo.NodeGuardingMaster}"/>
            </Grid>

            <Expander Header="{DynamicResource str_device_info_advanced_dcf}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Background="Transparent">
              <Grid ColumnDefinitions="Auto, 1.5*, 0.5*, Auto, 1.5*" RowDefinitions="Auto, Auto, Auto, Auto" Margin="0,15,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource str_dyn_040}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeviceCommissioning.NodeId}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,20,15"/>
                
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource str_dyn_044}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding DeviceCommissioning.NodeName}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>
                
                <!-- Row 1 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource str_dyn_001}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceCommissioning.Baudrate}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,20,15"/>

                <TextBlock Grid.Row="1" Grid.Column="3" Text="{DynamicResource str_device_info_net_number}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding DeviceCommissioning.NetNumber}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

                <!-- Row 2 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource str_device_info_net_name}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DeviceCommissioning.NetName}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,20,15"/>

                <TextBlock Grid.Row="2" Grid.Column="3" Text="{DynamicResource str_device_info_lss_serial}" VerticalAlignment="Center" Margin="0,0,10,15"/>
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DeviceCommissioning.LssSerialNo}" HorizontalAlignment="Stretch" Classes="clearButton" Margin="0,0,0,15"/>

                <!-- Row 3 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource str_device_info_canopen_manager}" VerticalAlignment="Center"/>
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DeviceCommissioning.CanopenManager}"/>
              </Grid>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
