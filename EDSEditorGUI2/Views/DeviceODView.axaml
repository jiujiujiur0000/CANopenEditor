<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:vm="using:EDSEditorGUI2.ViewModels"
             xmlns:view="using:EDSEditorGUI2.Views"
             xmlns:converter="using:EDSEditorGUI2.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="EDSEditorGUI2.Views.DeviceODView"
             x:DataType="vm:ObjectDictionary">
  <UserControl.Styles>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="GridSplitter.Horizontal">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style Selector="GridSplitter.Vertical">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
  </UserControl.Styles>

  <dialogHost:DialogHost Identifier="NoAnimationDialogHost" >
    <Grid ColumnDefinitions="350, Auto, *">
      <!-- Left Panel: OD Indexes -->
      <Grid RowDefinitions="*, Auto, *, Auto, *" Grid.Column="0" Margin="10,10,0,10">
        <view:ODIndexRangeView Grid.Row="0" DataContext="{Binding}"
                               x:Name="ODView_Com"
                               Heading="{DynamicResource str_od_comm_params}"
                               MinIndex="0x1000"
                               MaxIndex="0x1FFF"/>
        <GridSplitter Grid.Row="1" Classes="Horizontal" ResizeDirection="Rows" Background="Transparent" Height="8"/>
        
        <view:ODIndexRangeView Grid.Row="2" DataContext="{Binding}"
                               x:Name="ODView_Manufacture"
                               Heading="{DynamicResource str_od_mfg_params}"
                               MinIndex="0x2000"
                               MaxIndex="0x5FFF"/>
        <GridSplitter Grid.Row="3" Classes="Horizontal" ResizeDirection="Rows" Background="Transparent" Height="8"/>
        
        <view:ODIndexRangeView Grid.Row="4" DataContext="{Binding}"
                               x:Name="ODView_Device"
                               Heading="{DynamicResource str_od_dev_params}"
                               MinIndex="0x6000"
                               MaxIndex="0x9FFF"/>
      </Grid>

      <GridSplitter Grid.Column="1" Classes="Vertical" ResizeDirection="Columns" Background="Transparent" Width="8"/>
      
      <!-- Right Panel: DataGrid and Property Editor -->
      <Grid RowDefinitions="*, Auto, *" Grid.Column="2" Margin="10,10,10,10">
        <!-- Top: SubObjects DataGrid -->
        <Border Grid.Row="0" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="8" ClipToBounds="True">
          <DataGrid ItemsSource="{Binding SelectedObject.Value.SubObjects}"
                    x:Name="subindexGrid"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    Background="Transparent" RowBackground="Transparent"
                    FocusAdorner="{x:Null}">
          <DataGrid.Styles>
            <Style Selector="DataGridColumnHeader">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="SeparatorBrush" Value="Transparent"/>
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource str_od_col_sub}" Binding="{Binding Key, StringFormat='0x{0:X2}'}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_name}" Width="2*" Binding="{Binding Value.Name}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_datatype}" Width="*" Binding="{Binding Value.DataType}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_sdo}" Width="*" Binding="{Binding Value.Sdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_pdo}" Width="*" Binding="{Binding Value.Pdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_srdo}" Width="*" Binding="{Binding Value.Srdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_default}" Width="*" Binding="{Binding Value.DefaultValue}" />
          </DataGrid.Columns>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource str_od_menu_add}" Click="ContextMenuSubObjectAddClick">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource add_regular}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource str_od_menu_remove_shift}" Click="ContextMenuSubObjectRemoveClick" x:Name="contextMenu_subObject_removeSubItemToolStripMenuItem">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource remove_regular}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource str_od_menu_remove_gap}" Click="ContextMenuSubObjectRemoveClick">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource remove_regular}" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
          </DataGrid>
        </Border>
        
        <GridSplitter Grid.Row="1" Classes="Horizontal" ResizeDirection="Rows" Margin="0,5,0,10" Background="Transparent" Height="8"/>
        
        <!-- Bottom: Property Editor Forms -->
        <ScrollViewer Grid.Row="2" MaxHeight="500">
          <StackPanel Spacing="20" Margin="0,0,15,0">
            <!-- Basic Properties -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                    BoxShadow="0 2 6 0 #1A000000">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="100,*, 100,*">
                <TextBlock Text="{DynamicResource str_od_prop_index}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Spacing="10" Margin="0,0,20,15">
                  <TextBox Text="{Binding SelectedObject.Key}" IsEnabled="False" MinWidth="80"/>
                  <TextBlock Text="{DynamicResource str_od_prop_subindex}" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding SelectedSubObject.Key}" IsEnabled="False" MinWidth="80"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource str_od_prop_name}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,15"/>
                <TextBox Text="{Binding ActiveName}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,15"/>

                <TextBlock Text="{DynamicResource str_od_prop_denotation}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,0,15"/>
                <TextBox Text="{Binding ActiveAlias}" Grid.Row="2" Grid.Column="1" Margin="0,0,20,15"/>

                <TextBlock Text="{DynamicResource str_od_prop_desc}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top"/>
                <TextBox Text="{Binding SelectedObject.Value.Description}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,0"/>
              </Grid>
            </Border>

            <!-- Advanced Settings -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                    BoxShadow="0 2 6 0 #1A000000">
              <StackPanel Spacing="20">
                <TextBlock Text="{DynamicResource str_od_prop_obj_settings}" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource SystemAccentColor}" Margin="0,0,0,5"/>
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="0,0,0,1" Margin="0,-15,0,0" Opacity="0.3"/>
                
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="110,*, 110,*, 110,*">
                  <!-- Row 0 -->
                  <TextBlock Text="{DynamicResource str_od_prop_obj_type}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <ComboBox HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="1" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_highlimit}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <TextBox Text="{Binding SelectedSubObject.Value.HighLimit}" Grid.Row="0" Grid.Column="3" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_count_label}" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <TextBox Text="{Binding SelectedObject.Value.CountLabel}" Grid.Row="0" Grid.Column="5" Margin="0,0,0,15"/>

                  <!-- Row 1 -->
                  <TextBlock Text="{DynamicResource str_od_prop_datatype}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <ComboBox x:Name="combo_datatype" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.DataType}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_lowlimit}" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <TextBox Text="{Binding SelectedSubObject.Value.LowLimit}" Grid.Row="1" Grid.Column="3" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_storage}" Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <TextBox Text="{Binding SelectedObject.Value.StorageGroup}" Grid.Row="1" Grid.Column="5" Margin="0,0,0,15"/>

                  <!-- Row 2 -->
                  <TextBlock Text="{DynamicResource str_od_prop_acc_sdo}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <ComboBox x:Name="combo_sdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Sdo}" Grid.Row="2" Grid.Column="1" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_actual}" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <TextBox Text="" Grid.Row="2" Grid.Column="3" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_disabled}" Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <CheckBox IsChecked="{Binding SelectedObject.Value.Disabled}" Grid.Row="2" Grid.Column="5" Margin="0,0,0,15"/>

                  <!-- Row 3 -->
                  <TextBlock Text="{DynamicResource str_od_prop_acc_pdo}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <ComboBox x:Name="combo_pdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Pdo}" Grid.Row="3" Grid.Column="1" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_str_len}" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <NumericUpDown Value="{Binding SelectedSubObject.Value.StringLengthMin}" Grid.Row="3" Grid.Column="3" Margin="0,0,20,15"/>
                  
                  <TextBlock Text="{DynamicResource str_od_prop_tpdo_cos}" Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <CheckBox Grid.Row="3" Grid.Column="5" Margin="0,0,0,15"/>

                  <!-- Row 4 -->
                  <TextBlock Text="{DynamicResource str_od_prop_acc_srdo}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
                  <ComboBox x:Name="combo_srdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Srdo}" Grid.Row="4" Grid.Column="1" Margin="0,0,20,15"/>

                  <!-- Row 5 (Default Value and Actions) -->
                  <TextBlock Text="{DynamicResource str_od_col_default}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                  <TextBox Text="{Binding SelectedSubObject.Value.DefaultValue}" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,20,0"/>
                  
                  <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2" Spacing="20" HorizontalAlignment="Left">
                    <Button Content="{DynamicResource str_od_btn_save}" Classes="accent" Padding="20,8" FontWeight="SemiBold"/>
                    <CheckBox Content="{DynamicResource str_od_chk_autosave}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </dialogHost:DialogHost>
</UserControl>
