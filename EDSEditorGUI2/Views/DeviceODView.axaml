<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:vm="using:EDSEditorGUI2.ViewModels"
             xmlns:view="using:EDSEditorGUI2.Views"
             xmlns:converter="using:EDSEditorGUI2.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:EDSEditorGUI2"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="EDSEditorGUI2.Views.DeviceODView"
             x:DataType="vm:ObjectDictionary">
  <UserControl.Styles>
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="GridSplitter.Horizontal">
      <Setter Property="Height" Value="15"/>
      <Setter Property="Margin" Value="0,0"/>
    </Style>
    <Style Selector="GridSplitter.Vertical">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Margin" Value="0,0"/>
    </Style>
    <Style Selector="FlyoutPresenter.desc-flyout">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <converter:SubIndexConverter x:Key="SubIndexConverter"/>
    <converter:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
  </UserControl.Resources>

  <dialogHost:DialogHost Identifier="NoAnimationDialogHost" MaxWidth="1400">
    <Grid ColumnDefinitions="350, Auto, *" RowDefinitions="*, Auto, *, Auto, *">
      
      <!-- Left Panel: OD Indexes -->
      <view:ODIndexRangeView Grid.Row="0" Grid.Column="0" DataContext="{Binding}"
                             Margin="15,5,0,0"
                             x:Name="ODView_Com"
                             Heading="{DynamicResource str_od_comm_params}"
                             MinIndex="0x1000"
                             MaxIndex="0x1FFF"/>
      <GridSplitter Grid.Row="1" Grid.Column="0" Classes="Horizontal" ResizeDirection="Rows" Background="Transparent" Margin="15,0,0,0"/>
      
      <view:ODIndexRangeView Grid.Row="2" Grid.Column="0" DataContext="{Binding}"
                             Margin="15,0,0,0"
                             x:Name="ODView_Manufacture"
                             Heading="{DynamicResource str_od_mfg_params}"
                             MinIndex="0x2000"
                             MaxIndex="0x5FFF"/>
      <GridSplitter Grid.Row="3" Grid.Column="0" Classes="Horizontal" ResizeDirection="Rows" Background="Transparent" Margin="15,0,0,0"/>
      
      <view:ODIndexRangeView Grid.Row="4" Grid.Column="0" DataContext="{Binding}"
                             Margin="15,0,0,15"
                             x:Name="ODView_Device"
                             Heading="{DynamicResource str_od_dev_params}"
                             MinIndex="0x6000"
                             MaxIndex="0x9FFF"/>

      <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="5" Classes="Vertical" ResizeDirection="Columns" Background="Transparent"/>
      
      <!-- Right Panel -->
      <ScrollViewer Grid.Column="2" Grid.Row="0" Grid.RowSpan="5" Margin="0,5,5,15" BringIntoViewOnFocusChange="False">
        <StackPanel Spacing="20" Margin="0,0,15,0">
        
        <!-- Top: Index Properties (Row 0) -->
        <Grid Grid.Row="0" RowDefinitions="Auto, *">
          <TextBlock Grid.Row="0" Text="{DynamicResource str_od_panel_basic_info}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
          <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="20"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                  BoxShadow="0 2 6 0 #1A000000" Margin="0,0,0,0">
            <StackPanel Spacing="15">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="80,1.5*, 0.5*, 80,1.5*">
              <TextBlock Text="{DynamicResource str_od_prop_index}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedObject.Key}" Grid.Row="0" Grid.Column="1" IsEnabled="False" Margin="0,0,20,15"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_obj_type}" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedObjectType}" Grid.Row="0" Grid.Column="4" Margin="0,0,0,15" IsEnabled="False"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_name}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedObject.Value.Name}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,15"/>

              <TextBlock Text="{DynamicResource str_od_prop_denotation}" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedObject.Value.Alias}" Grid.Row="1" Grid.Column="4" Margin="0,0,0,15"/>

              <TextBlock Text="{DynamicResource str_od_prop_desc}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="odDescButton" Grid.Row="2" Grid.Column="1" Margin="0,0,20,0" 
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" MinHeight="32" 
                      Background="{DynamicResource TextControlBackground}"
                      BorderBrush="{DynamicResource TextControlBorderBrush}"
                      BorderThickness="{DynamicResource TextControlBorderThemeThickness}">
                <TextBlock Text="{Binding SelectedObject.Value.Description}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                <Button.Flyout>
                  <Flyout Placement="Top" FlyoutPresenterClasses="desc-flyout">
                    <TextBox Text="{Binding SelectedObject.Value.Description}" Width="{Binding #odDescButton.Bounds.Width}" Height="200" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Watermark="{DynamicResource str_dyn_045}"/>
                  </Flyout>
                </Button.Flyout>
              </Button>

              <TextBlock Text="{DynamicResource str_od_prop_status}" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox SelectedIndex="{Binding SelectedObject.Value.Disabled, Converter={StaticResource BooleanToStatusConverter}}" Grid.Row="2" Grid.Column="4" Margin="0,0,0,0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{DynamicResource str_od_menu_enable}"/>
                <ComboBoxItem Content="{DynamicResource str_od_menu_disable}"/>
              </ComboBox>
              </Grid>
              
              <!-- Advanced CANopenNode Settings (Expander) -->
              <Expander Header="{DynamicResource str_od_adv_ext_config}" HorizontalAlignment="Stretch" Margin="0,0,0,0" Background="{DynamicResource GlobalExpanderHeaderBackground}">
                <Grid RowDefinitions="Auto" ColumnDefinitions="80,1.5*, 0.5*, 100,1.5*">
                    <TextBlock Text="{DynamicResource str_od_prop_storage}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SelectedObject.Value.StorageGroup}" Grid.Row="0" Grid.Column="1" Margin="0,0,20,0"/>

                    <TextBlock Text="{DynamicResource str_od_prop_count_label}" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SelectedObject.Value.CountLabel}" Grid.Row="0" Grid.Column="4" Margin="0,0,0,0"/>
                </Grid>
              </Expander>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Middle: SubObjects DataGrid (Row 1) -->
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}">
          <TextBlock Grid.Row="0" Text="{DynamicResource str_od_panel_subobj_list}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
          
          <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="8" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding SelectedObject.Value.SubObjects}"
                      x:Name="subindexGrid"
                      CanUserResizeColumns="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent" RowBackground="Transparent"
                      FocusAdorner="{x:Null}"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      PointerPressed="SubObjectDataGrid_PointerPressed">
            <DataGrid.Styles>
              <Style Selector="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="SeparatorBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
              </Style>
              <Style Selector="DataGridColumnHeader:nth-last-child(1)">
                <Setter Property="SeparatorBrush" Value="Transparent"/>
              </Style>
              <Style Selector="DataGridRow">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
              </Style>
              <Style Selector="DataGridRow:nth-last-child(1)">
                <Setter Property="BorderThickness" Value="0"/>
              </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="{DynamicResource str_od_col_sub}" Width="Auto" MinWidth="80" SortMemberPath="Key">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Margin="12,0" VerticalAlignment="Center">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource SubIndexConverter}">
                          <Binding Path="Key" />
                          <Binding Path="$parent[DataGrid].DataContext" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="{DynamicResource str_od_col_name}" Width="1.9*" Binding="{Binding Value.Name}" />
              <DataGridTextColumn Header="{DynamicResource str_od_col_datatype}" Width="Auto" Binding="{Binding Value.DataType}" />
              <DataGridTextColumn Header="{DynamicResource str_od_col_sdo}" Width="Auto" Binding="{Binding Value.Sdo}" />
              <DataGridTextColumn Header="{DynamicResource str_od_col_pdo}" Width="Auto" Binding="{Binding Value.Pdo}" />
              <DataGridTextColumn Header="{DynamicResource str_od_col_srdo}" Width="Auto" Binding="{Binding Value.Srdo}" />
              <DataGridTextColumn Header="{DynamicResource str_od_col_default}" Width="*" Binding="{Binding Value.DefaultValue}" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
              <ContextMenu MinHeight="0">
                <ContextMenu.Resources>
                  <Thickness x:Key="MenuFlyoutPresenterThemePadding">0</Thickness>
                  <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
                </ContextMenu.Resources>
                <MenuItem Header="{DynamicResource str_od_menu_remove_shift}" Click="ContextMenuSubObjectRemoveClick" x:Name="contextMenu_subObject_removeSubItemToolStripMenuItem" IsVisible="{Binding #subindexGrid.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource remove_regular}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource str_od_menu_remove_gap}" Click="ContextMenuSubObjectRemoveClick" IsVisible="{Binding #subindexGrid.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource remove_regular}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource str_od_menu_add}" Click="ContextMenuSubObjectAddClick">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource add_regular}" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </DataGrid.ContextMenu>
            </DataGrid>
          </Border>
        </Grid>

        <!-- Bottom: Sub-Index Properties (Row 3) -->
        <StackPanel Spacing="15" IsVisible="{Binding SelectedObject.Value, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{DynamicResource str_od_panel_subobj_props}" FontWeight="Bold" FontSize="15" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}"/>
          <TextBlock Text="{DynamicResource str_od_panel_var_props}" FontWeight="Bold" FontSize="15" IsVisible="{Binding SelectedObject.Value.IsVar}"/>
          <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="25"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                  BoxShadow="0 2 6 0 #1A000000">
          <StackPanel Spacing="15">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="80,1.5*, 0.5*, 100,1.5*">
              
              <!-- Row 0: SubIndex & Name -->
              <TextBlock Text="{DynamicResource str_od_prop_subindex}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}"/>
              <TextBox Text="{Binding SelectedSubObject.Key}" Grid.Row="0" Grid.Column="1" IsEnabled="False" Margin="0,0,20,15" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_name}" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}"/>
              <TextBox Text="{Binding SelectedSubObject.Value.Name}" Grid.Row="0" Grid.Column="4" Margin="0,0,0,15" IsVisible="{Binding SelectedObject.Value.IsRecordOrArray}"/>

              <!-- Row 1: DataType & String Length -->
              <TextBlock Text="{DynamicResource str_od_prop_datatype}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <ComboBox x:Name="combo_datatype" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.DataType}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,15"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_str_len}" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedSubObject.Value.StringLengthMin}" Grid.Row="1" Grid.Column="4" Margin="0,0,0,15"/>
              <TextBlock Text="{DynamicResource str_od_col_default}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedSubObject.Value.DefaultValue}" Grid.Row="2" Grid.Column="1" Margin="0,0,20,15"/>

              <TextBlock Text="{DynamicResource str_od_prop_highlimit}" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedSubObject.Value.HighLimit}" Grid.Row="2" Grid.Column="4" Margin="0,0,0,15"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_lowlimit}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <TextBox Text="{Binding SelectedSubObject.Value.LowLimit}" Grid.Row="3" Grid.Column="1" Margin="0,0,20,15"/>

              <TextBlock Text="{DynamicResource str_od_prop_acc_sdo}" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,15"/>
              <ComboBox x:Name="combo_sdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Sdo}" Grid.Row="3" Grid.Column="4" Margin="0,0,0,15"/>
              
              <TextBlock Text="{DynamicResource str_od_prop_acc_pdo}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="combo_pdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Pdo}" Grid.Row="4" Grid.Column="1" Margin="0,0,20,0"/>

              <TextBlock Text="{DynamicResource str_od_prop_acc_srdo}" Grid.Row="4" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="combo_srdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Srdo}" Grid.Row="4" Grid.Column="4" Margin="0,0,0,0"/>
              </Grid>

              <Expander Header="{DynamicResource str_device_info_advanced_dcf}" HorizontalAlignment="Stretch" Margin="0,15,0,0" Background="{DynamicResource GlobalExpanderHeaderBackground}">
                <Grid ColumnDefinitions="80,1.5*, 0.5*, 100,1.5*" RowDefinitions="Auto">
                  <TextBlock Text="{DynamicResource str_od_prop_actual}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox Text="{Binding SelectedSubObject.Value.ActualValue}" Grid.Row="0" Grid.Column="1" Margin="0,0,20,0"/>
                </Grid>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </dialogHost:DialogHost>
</UserControl>
