<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:vm="using:EDSEditorGUI2.ViewModels"
             xmlns:view="using:EDSEditorGUI2.Views"
             xmlns:converter="using:EDSEditorGUI2.Converter"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="EDSEditorGUI2.Views.DeviceODView"
             x:DataType="vm:ObjectDictionary">

  <dialogHost:DialogHost Identifier="NoAnimationDialogHost" >
    <Grid ColumnDefinitions="200,4,*">
      <Grid RowDefinitions="*,4,*,4,*" Grid.Column="0">
        <view:ODIndexRangeView Grid.Row="0" DataContext="{Binding}"
                               x:Name="ODView_Com"
                               Heading="{DynamicResource str_od_comm_params}"
                               MinIndex="0x1000"
                               MaxIndex="0x1FFF"/>
        <GridSplitter Grid.Row="1" Background="Black" ResizeDirection="Rows"/>
        <view:ODIndexRangeView Grid.Row="2" DataContext="{Binding}"
                               x:Name="ODView_Manufacture"
                               Heading="{DynamicResource str_od_mfg_params}"
                               MinIndex="0x2000"
                               MaxIndex="0x5FFF"/>
        <GridSplitter Grid.Row="3" Background="Black" ResizeDirection="Rows"/>
        <view:ODIndexRangeView Grid.Row="4" DataContext="{Binding}"
                               x:Name="ODView_Device"
                               Heading="{DynamicResource str_od_dev_params}"
                               MinIndex="0x6000"
                               MaxIndex="0x9FFF"/>
      </Grid>

      <GridSplitter Grid.Column="1" Background="Black" ResizeDirection="Columns"/>
      <Grid RowDefinitions="*,4,*" Grid.Column="2">
        <DataGrid Margin="2" ItemsSource="{Binding SelectedObject.Value.SubObjects}"
                  x:Name="subindexGrid"
                  GridLinesVisibility="All"
                  BorderThickness="1" BorderBrush="Gray">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{DynamicResource str_od_col_sub}" Width="*" Binding="{Binding Key}"/>
            <DataGridTextColumn Header="{DynamicResource str_od_col_name}" Width="*" Binding="{Binding Value.Name}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_datatype}" Width="*" Binding="{Binding Value.DataType}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_sdo}" Width="*" Binding="{Binding Value.Sdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_pdo}" Width="*" Binding="{Binding Value.Pdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_srdo}" Width="*" Binding="{Binding Value.Srdo}" />
            <DataGridTextColumn Header="{DynamicResource str_od_col_default}" Width="*" Binding="{Binding Value.DefaultValue}" />
          </DataGrid.Columns>
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{DynamicResource str_od_menu_add}" Click="ContextMenuSubObjectAddClick">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource add_regular}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource str_od_menu_remove_shift}" Click="ContextMenuSubObjectRemoveClick" x:Name="contextMenu_subObject_removeSubItemToolStripMenuItem">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource remove_regular}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{DynamicResource str_od_menu_remove_gap}" Click="ContextMenuSubObjectRemoveClick">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource remove_regular}" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        <GridSplitter Grid.Row="1" Background="Black" ResizeDirection="Rows"/>
        <StackPanel Grid.Row="2">
          <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="100,*" Grid.Column="2">
            <TextBlock Text="{DynamicResource str_od_prop_index}" Grid.Row="0" Grid.Column="0"/>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
              <TextBox Text="{Binding SelectedObject.Key}" IsEnabled="False"/>
              <TextBlock Text="{DynamicResource str_od_prop_subindex}" />
              <TextBox Text="{Binding SelectedSubObject.Key}" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource str_od_prop_name}" Grid.Row="1" Grid.Column="0" />
            <TextBox Background="Red" Text="{Binding SelectedSubObject.Value.Name}" Grid.Row="1" Grid.Column="1" />

            <TextBlock Text="{DynamicResource str_od_prop_denotation}" Grid.Row="2" Grid.Column="0"/>
            <TextBox Background="Black" Text="" Grid.Row="2" Grid.Column="1" />

            <TextBlock Text="{DynamicResource str_od_prop_desc}" Grid.Row="3" Grid.Column="0"/>
            <TextBox Background="Yellow" Text="{Binding SelectedObject.Value.Description}" Grid.Row="3" Grid.Column="1" Height="100" />
          </Grid>
          <TextBlock Text="{DynamicResource str_od_prop_obj_settings}" />
          
          <Grid RowDefinitions="*,*,*,*,*,*" ColumnDefinitions="100,*,*,*,*,*" >
            <TextBlock Text="{DynamicResource str_od_prop_obj_type}" Grid.Row="0" Grid.Column="0"/>
            <ComboBox Background="Black" HorizontalAlignment="Stretch" Grid.Row="0" Grid.Column="1" />
            <TextBlock Text="{DynamicResource str_od_prop_highlimit}" Grid.Row="0" Grid.Column="2"/>
            <TextBox Background="Red" Text="{Binding SelectedSubObject.Value.HighLimit}" Grid.Row="0" Grid.Column="3" />
            <TextBlock Text="{DynamicResource str_od_prop_count_label}" Grid.Row="0" Grid.Column="4"/>
            <TextBox Background="Yellow" Text="{Binding SelectedObject.Value.CountLabel}" Grid.Row="0" Grid.Column="5" />

            <TextBlock Text="{DynamicResource str_od_prop_datatype}" Grid.Row="1" Grid.Column="0"/>
            <ComboBox Background="Red" x:Name="combo_datatype" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.DataType}" Grid.Row="1" Grid.Column="1" />
            <TextBlock Text="{DynamicResource str_od_prop_lowlimit}" Grid.Row="1" Grid.Column="2"/>
            <TextBox Background="Red" Text="{Binding SelectedSubObject.Value.LowLimit}" Grid.Row="1" Grid.Column="3" />
            <TextBlock Text="{DynamicResource str_od_prop_storage}" Grid.Row="1" Grid.Column="4"/>
            <TextBox Background="Yellow" Text="{Binding SelectedObject.Value.StorageGroup}" Grid.Row="1" Grid.Column="5" />

            <TextBlock Text="{DynamicResource str_od_prop_acc_sdo}" Grid.Row="2" Grid.Column="0"/>
            <ComboBox Background="Red" x:Name="combo_sdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Sdo}" Grid.Row="2" Grid.Column="1" />
            <TextBlock Text="{DynamicResource str_od_prop_actual}" Grid.Row="2" Grid.Column="2"/>
            <TextBox Background="Black" Text="" Grid.Row="2" Grid.Column="3" />
            <TextBlock Text="{DynamicResource str_od_prop_disabled}" Grid.Row="2" Grid.Column="4"/>
            <CheckBox Background="Yellow" IsChecked="{Binding SelectedObject.Value.Disabled}" Grid.Row="2" Grid.Column="5"/>

            <TextBlock Text="{DynamicResource str_od_prop_acc_pdo}" Grid.Row="3" Grid.Column="0"/>
            <ComboBox Background="Red" x:Name="combo_pdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Pdo}" Grid.Row="3" Grid.Column="1" />
            <TextBlock Text="{DynamicResource str_od_prop_str_len}" Grid.Row="3" Grid.Column="2"/>
            <NumericUpDown Background="Red" Value="{Binding SelectedSubObject.Value.StringLengthMin}" Grid.Row="3" Grid.Column="3" />
            <TextBlock Text="{DynamicResource str_od_prop_tpdo_cos}" Grid.Row="3" Grid.Column="4"/>
            <CheckBox Background="Black" Grid.Row="3" Grid.Column="5"/>

            <TextBlock Text="{DynamicResource str_od_prop_acc_srdo}" Grid.Row="4" Grid.Column="0"/>
            <ComboBox Background="Red" x:Name="combo_srdo" HorizontalAlignment="Stretch" SelectedIndex="{Binding SelectedSubObject.Value.Srdo}" Grid.Row="4" Grid.Column="1" />

            <TextBlock Text="{DynamicResource str_od_col_default}" Grid.Row="5" Grid.Column="0"/>
            <TextBox Background="Red" Text="{Binding SelectedSubObject.Value.DefaultValue}" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" />
            <Button Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2" Content="{DynamicResource str_od_btn_save}">Save</Button>
            <CheckBox Background="Green" Grid.Row="5" Grid.Column="5" Content="{DynamicResource str_od_chk_autosave}">Autosave</CheckBox>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
  </dialogHost:DialogHost>
</UserControl>
