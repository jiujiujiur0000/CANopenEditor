<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             x:Class="EDSEditorGUI2.Views.CollisionDialog">
    <StackPanel Margin="24" Spacing="20" MinWidth="420">
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="⚠️" FontSize="24" VerticalAlignment="Center" Foreground="#E5A910"/>
            <TextBlock FontWeight="Bold" FontSize="18" Text="{DynamicResource str_collision_title}" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Message -->
        <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" Margin="36,0,0,0" />
        
        <!-- Checkbox -->
        <CheckBox x:Name="ApplyToAllCheckBox" Content="{DynamicResource str_collision_apply_all}" Margin="36,10,0,10" />
        
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,10" Opacity="0.5" />

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{DynamicResource str_collision_overwrite}" Tag="Overwrite" Click="Button_Click" MinWidth="90" HorizontalContentAlignment="Center" Classes="accent" />
            <Button Content="{DynamicResource str_collision_skip}" Tag="Skip" Click="Button_Click" MinWidth="90" HorizontalContentAlignment="Center" />
            <Button Content="{DynamicResource str_collision_cancel}" Tag="Cancel" Click="Button_Click" MinWidth="90" HorizontalContentAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
