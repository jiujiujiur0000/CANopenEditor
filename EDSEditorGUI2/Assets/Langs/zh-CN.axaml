<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- MainWindow Menu -->
    <sys:String x:Key="str_menu_file">文件(_F)</sys:String>
    <sys:String x:Key="str_menu_new">新建(_N)</sys:String>
    <sys:String x:Key="str_menu_open">打开(_O)</sys:String>
