<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- MainWindow Menu -->
    <sys:String x:Key="str_menu_file">文件(_F)</sys:String>
    <sys:String x:Key="str_menu_new">新建(_N)</sys:String>
    <sys:String x:Key="str_menu_open">打开(_O)</sys:String>
    <sys:String x:Key="str_menu_save">保存工程(_S)</sys:String>
    <sys:String x:Key="str_menu_save_as">另存为(_A)...</sys:String>
    <sys:String x:Key="str_menu_open_network">打开网络配置(_N)</sys:String>
    <sys:String x:Key="str_menu_save_network">保存网络配置(_K)</sys:String>
    <sys:String x:Key="str_menu_recent">最近文件(_R)</sys:String>
    <sys:String x:Key="str_menu_export">导出(_E)</sys:String>
    <sys:String x:Key="str_menu_export_canopennode">导出CanOpenNode代码(_C)...</sys:String>
    <sys:String x:Key="str_menu_save_all">全部保存(_A)</sys:String>
    <sys:String x:Key="str_menu_quit">退出(_Q)</sys:String>

    <sys:String x:Key="str_menu_insert_profile">插入对象配置(_I)</sys:String>
    <sys:String x:Key="str_menu_reports">报告(_R)</sys:String>
    <sys:String x:Key="str_menu_tools">工具</sys:String>
    <sys:String x:Key="str_menu_preferences">偏好设置(_P)</sys:String>

    <!-- Preferences View -->
    <sys:String x:Key="str_pref_title">偏好设置</sys:String>
    <sys:String x:Key="str_pref_language">语言</sys:String>
    <sys:String x:Key="str_pref_exporter">默认导出代码版本</sys:String>
    <sys:String x:Key="str_pref_warnings">警报配置</sys:String>
    <sys:String x:Key="str_pref_warn_generic">常规警告</sys:String>
    <sys:String x:Key="str_pref_warn_rename">变量重命名警告</sys:String>
    <sys:String x:Key="str_pref_warn_build">代码构建警告</sys:String>
    <sys:String x:Key="str_pref_warn_string">字符串长度警告</sys:String>
    <sys:String x:Key="str_pref_warn_struct">结构体成员对齐警告</sys:String>
    <sys:String x:Key="str_btn_save">保存</sys:String>
    <sys:String x:Key="str_btn_cancel">取消</sys:String>

    <!-- Insert Objects Dialog -->
    <sys:String x:Key="str_profile_open_file">打开对象字典文件...</sys:String>
    <sys:String x:Key="str_insert_target">目标设备:</sys:String>
    <sys:String x:Key="str_insert_offset">索引偏移 (填单个偏移，或用空格隔开以支持批量多份插入)</sys:String>
    <sys:String x:Key="str_insert_col_insert">是否插入</sys:String>
    <sys:String x:Key="str_insert_col_original">原始对象字典</sys:String>
    <sys:String x:Key="str_insert_btn_insert">插入</sys:String>

    <!-- Device View Tabs -->
    <sys:String x:Key="str_tab_device_info">设备信息</sys:String>
    <sys:String x:Key="str_tab_object_dict">对象字典</sys:String>
    <sys:String x:Key="str_tab_tx_pdo">发送(TX) PDO 映射</sys:String>
    <sys:String x:Key="str_tab_rx_pdo">接收(RX) PDO 映射</sys:String>
    <sys:String x:Key="str_tab_modules">模块</sys:String>

    <!-- Device Info View -->
    <sys:String x:Key="str_device_info_title">设备基本信息:</sys:String>
    <sys:String x:Key="str_device_info_prod_name">产品名称</sys:String>
    <sys:String x:Key="str_device_info_vendor_name">厂商名称</sys:String>
    <sys:String x:Key="str_device_info_features">通用及主站特性:</sys:String>
    <sys:String x:Key="str_device_info_lss_slave">LSS 从站</sys:String>
    <sys:String x:Key="str_device_info_lss_master">CANopen 主站</sys:String>
    <sys:String x:Key="str_device_info_baudrates">支持的波特率</sys:String>
    <sys:String x:Key="str_device_info_auto">自动检测</sys:String>

    <!-- Device Object Dictionary View -->
    <sys:String x:Key="str_od_comm_params">通信特定参数</sys:String>
    <sys:String x:Key="str_od_mfg_params">制造商特定参数</sys:String>
    <sys:String x:Key="str_od_dev_params">设备规范特定参数</sys:String>
    
    <sys:String x:Key="str_od_col_sub">子索引</sys:String>
    <sys:String x:Key="str_od_col_name">名称</sys:String>
    <sys:String x:Key="str_od_col_datatype">数据类型</sys:String>
    <sys:String x:Key="str_od_col_sdo">SDO</sys:String>
    <sys:String x:Key="str_od_col_pdo">PDO</sys:String>
    <sys:String x:Key="str_od_col_srdo">SRDO</sys:String>
    <sys:String x:Key="str_od_col_default">默认值</sys:String>
    
    <sys:String x:Key="str_od_menu_add">添加</sys:String>
    <sys:String x:Key="str_od_menu_remove_shift">移除 (并上移)</sys:String>
    <sys:String x:Key="str_od_menu_remove_gap">移除 (并留空)</sys:String>
    
    <sys:String x:Key="str_od_prop_index">索引</sys:String>
    <sys:String x:Key="str_od_prop_subindex">子索引</sys:String>
    <sys:String x:Key="str_od_prop_name">名称</sys:String>
    <sys:String x:Key="str_od_prop_denotation">表示符</sys:String>
    <sys:String x:Key="str_od_prop_desc">描述</sys:String>
    <sys:String x:Key="str_od_prop_obj_settings">对象设置</sys:String>
    <sys:String x:Key="str_od_prop_obj_type">对象类型</sys:String>
    <sys:String x:Key="str_od_prop_datatype">数据类型</sys:String>
    <sys:String x:Key="str_od_prop_default">默认值</sys:String>
    <sys:String x:Key="str_od_prop_highlimit">上限值</sys:String>
    <sys:String x:Key="str_od_prop_count_label">计数标签</sys:String>
    <sys:String x:Key="str_od_prop_lowlimit">下限值</sys:String>
    <sys:String x:Key="str_od_prop_storage">存储组</sys:String>
    <sys:String x:Key="str_od_prop_acc_sdo">SDO 访问</sys:String>
    <sys:String x:Key="str_od_prop_actual">当前值</sys:String>
    <sys:String x:Key="str_od_prop_disabled">已禁用</sys:String>
    <sys:String x:Key="str_od_prop_acc_pdo">PDO 访问</sys:String>
    <sys:String x:Key="str_od_prop_str_len">字符串最小长度</sys:String>
    <sys:String x:Key="str_od_prop_tpdo_cos">TPDO COS计数</sys:String>
    <sys:String x:Key="str_od_prop_acc_srdo">SRDO 访问</sys:String>
    <sys:String x:Key="str_od_btn_save">保存修改</sys:String>
    <sys:String x:Key="str_od_chk_autosave">自动保存修改</sys:String>

    <!-- Device PDO View -->
    <sys:String x:Key="str_pdo_col_index">索引</sys:String>
    <sys:String x:Key="str_pdo_col_sub">子索引</sys:String>
    <sys:String x:Key="str_pdo_col_name">名称</sys:String>
    <sys:String x:Key="str_pdo_col_datatype">数据类型</sys:String>
    <sys:String x:Key="str_pdo_col_bits">位数</sys:String>
    
    <sys:String x:Key="str_pdo_comm_params">通信参数:</sys:String>
    <sys:String x:Key="str_pdo_comm">通信设置</sys:String>
    <sys:String x:Key="str_pdo_mapping">映射</sys:String>
    <sys:String x:Key="str_pdo_btn_add">添加 PDO</sys:String>
    <sys:String x:Key="str_pdo_cob">COB</sys:String>
    <sys:String x:Key="str_pdo_type">类型 (Type)</sys:String>
    <sys:String x:Key="str_pdo_btn_delete">删除 PDO</sys:String>
    <sys:String x:Key="str_pdo_inhibit">禁止时间</sys:String>
    <sys:String x:Key="str_pdo_event_timer">事件定时器</sys:String>
    <sys:String x:Key="str_pdo_btn_save">保存</sys:String>
    <sys:String x:Key="str_pdo_sync_start">同步启动</sys:String>
    <sys:String x:Key="str_pdo_chk_invalid">失效</sys:String>
    <sys:String x:Key="str_pdo_id">ID</sys:String>
    <sys:String x:Key="str_pdo_zoom">缩放:</sys:String>

    <!-- OD Index Range View -->
    <sys:String x:Key="str_od_menu_clone">克隆...</sys:String>
    <sys:String x:Key="str_od_menu_delete">删除...</sys:String>
    <sys:String x:Key="str_od_menu_toggle">切换...</sys:String>
    <sys:String x:Key="str_od_dlg_index">索引 (hex):</sys:String>
    <sys:String x:Key="str_od_dlg_name">名称:</sys:String>
    <sys:String x:Key="str_od_dlg_objtype">对象类型:</sys:String>
    <sys:String x:Key="str_od_btn_create">创建</sys:String>
    <sys:String x:Key="str_od_btn_cancel">取消</sys:String>

    <!-- Modules Tab -->
    <sys:String x:Key="str_module_connected_count">已连接模块数量：</sys:String>
    <sys:String x:Key="str_module_list">模块列表：</sys:String>
    <sys:String x:Key="str_module_extended_objects">扩展对象：</sys:String>
    <sys:String x:Key="str_module_comments">模块描述：</sys:String>
    
    <sys:String x:Key="str_module_col_status">状态</sys:String>
    <sys:String x:Key="str_module_col_index">索引</sys:String>
    <sys:String x:Key="str_module_col_product_name">产品名称</sys:String>
    <sys:String x:Key="str_module_col_version">版本</sys:String>
    <sys:String x:Key="str_module_col_revision">修订号</sys:String>
    <sys:String x:Key="str_module_col_order_code">订货号</sys:String>
    <sys:String x:Key="str_module_col_name">名称</sys:String>
</ResourceDictionary>
