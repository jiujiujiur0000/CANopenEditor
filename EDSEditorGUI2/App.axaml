<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="EDSEditorGUI2.App"
             xmlns:local="using:EDSEditorGUI2"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://EDSEditorGUI2/Assets/Langs/en-US.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MainAppBackgroundBrush">#F3F4F6</SolidColorBrush>
                    <SolidColorBrush x:Key="SidePanelBackgroundBrush">#FAFAFA</SolidColorBrush>
                    <SolidColorBrush x:Key="TabUnselectedBackgroundBrush">#E5E7EB</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="TextControlBackground">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#EAEAEA</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
                    
                    <Color x:Key="TextFillColorPrimary">#1A1A1A</Color>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="GlobalExpanderHeaderBackground">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="GlobalCustomTextBrush">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="TableBorderBrush">#D3D3D3</SolidColorBrush>
                    <SolidColorBrush x:Key="TableEmptyBgBrush">#F5F5F5</SolidColorBrush>
                    <SolidColorBrush x:Key="TableFilledBgBrush">#F0E68C</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="MainAppBackgroundBrush">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SidePanelBackgroundBrush">#252526</SolidColorBrush>
                    <SolidColorBrush x:Key="TabUnselectedBackgroundBrush">#2D2D30</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackgroundBrush">#252526</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="TextControlBackground">#333337</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#3E3E42</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#1E1E1E</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="ComboBoxBackground">#333337</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver">#3E3E42</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="TextControlForeground">#DCDCDC</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush">#DCDCDC</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush">#DCDCDC</SolidColorBrush>
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush">#DCDCDC</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="ExpanderHeaderBackground">#333337</SolidColorBrush>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#3E3E42</SolidColorBrush>
                    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="GlobalExpanderHeaderBackground">#333337</SolidColorBrush>
                    
                    <Color x:Key="TextFillColorPrimary">#DCDCDC</Color>
                    <Color x:Key="TextFillColorSecondary">#A0A0A0</Color>
                    <Color x:Key="TextFillColorTertiary">#888888</Color>
                    <SolidColorBrush x:Key="GlobalCustomTextBrush">#DCDCDC</SolidColorBrush>
                    <SolidColorBrush x:Key="TableBorderBrush">#404040</SolidColorBrush>
                    <SolidColorBrush x:Key="TableEmptyBgBrush">#202020</SolidColorBrush>
                    <SolidColorBrush x:Key="TableFilledBgBrush">#4A4A20</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window, UserControl, ContextMenu, ToolTip, FlyoutPresenter, MenuItem, CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI, PingFang SC, sans-serif"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="{DynamicResource GlobalExpanderHeaderBackground}" />
        </Style>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://EDSEditorGUI2/Icons.axaml"/>
        <dialogHostAvalonia:DialogHostStyles />
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <!-- Hide the sort icon but keep sorting enabled -->
        <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}"/>
        </Style>
        
        <!-- Global override for TextBox -->
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>
</Application>