<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             x:Class="EDSEditorGUI2.App"
             xmlns:local="using:EDSEditorGUI2"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://EDSEditorGUI2/Assets/Langs/en-US.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SystemRegionBrush">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush">#252526</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush">#2D2D30</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush">#3E3E42</SolidColorBrush>
                    <SolidColorBrush x:Key="SystemControlBackgroundAltLowBrush">#333337</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            
            <SolidColorBrush x:Key="TextControlBackground">#F5F5F5</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#EAEAEA</SolidColorBrush>
            <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <Style Selector="Window, UserControl, ContextMenu, ToolTip, FlyoutPresenter">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI, PingFang SC, sans-serif"/>
        </Style>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://EDSEditorGUI2/Icons.axaml"/>
        <dialogHostAvalonia:DialogHostStyles />
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <!-- Hide the sort icon but keep sorting enabled -->
        <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}"/>
        </Style>
        
        <!-- Global override for TextBox -->
        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Styles>
</Application>